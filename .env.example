BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
ALLOWED_TELEGRAM_IDS=123456789,987654321
BASE_URL=http://localhost:8000
MODE=polling
WEBHOOK_PATH=/telegram/webhook
WEBHOOK_SECRET=generate_with_python_secrets_token_urlsafe_24
SECRET_KEY=generate_with_python_secrets_token_urlsafe_32
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
TZ=Europe/Moscow

# DEBUG=true allows fallback auth without initData (for local dev only)
# Set to false in production — unauthorized requests will get 401
DEBUG=true

STT_ENGINE=faster_whisper
WHISPER_MODEL=Systran/faster-whisper-small
STT_LANGUAGE=ru
MAX_VOICE_DURATION_SECONDS=120

LLM_PROVIDER=rule_based
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b-instruct

OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen-2.5-7b-instruct

DEFAULT_CURRENCY=RUB
OCR_API_KEY=helloworld
NOTIFY_THRESHOLD=5000.0

# VPS Deployment Configuration
VPS_HOST=89.169.53.163
VPS_USER=root
VPS_PASSWORD=your_vps_password_here
VPS_SSH_KEY=~/.ssh/id_rsa
